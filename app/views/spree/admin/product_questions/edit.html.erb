<% content_for :page_title do %>
  <%= page_header_back_button spree.admin_product_product_questions_path(@product_question.product) %>
  <%= @product_question.product.name %> : <%= Spree.t('products_qa.config_name') %>
<% end %>

<%= render partial: 'spree/admin/shared/error_messages', locals: { target: @product_question } %>

<%= form_for [:admin, @product, @product_question], method: :put, html: { multipart: true } do |f| %>
  <fieldset class="no-border-top">
    <%= render partial: 'form', locals: { f: f } %>
    <%= render partial: 'spree/admin/shared/edit_resource_links', locals: { f: f } %>
  </fieldset>
<% end %>
