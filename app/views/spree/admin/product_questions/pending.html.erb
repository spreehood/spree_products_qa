<% content_for :page_title do %>
  <%= t(:products_with_pending_questions) %>
<% end %>

<% if @collection.any? %>
  <div class="card">
    <div class="table-responsive">
      <table class="table">
        <thead >
          <tr class="w-full">
            <th><%= Spree.t(:products) %></th>
            <th class="actions"></th>
          </tr>
        </thead>
        <tbody>
          <% @collection.uniq.each do |product| %>
            <tr class="<%= cycle('odd', 'even') %>">
              <td>
                <%= link_to product.name, edit_admin_product_path(product) %>
              </td>
              <td class="actions" data-hook="admin_products_pending_questions_index_row_actions">
                <%= link_to t(:go_to_questions), admin_product_product_questions_path(product) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% else %>
  <div class="alpha twelve columns no-objects-found">
    <%= t(:no_pending_questions) %>
  </div>
<% end %>
